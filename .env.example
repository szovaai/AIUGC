# Copy to .env and fill in

# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=

# ElevenLabs — https://elevenlabs.io (Profile -> API Keys)
ELEVENLABS_API_KEY=

# Optional overrides
# Avatar video model (default: kling v2 standard @ ~$0.0562/s)
AVATAR_MODEL=fal-ai/kling-video/ai-avatar/v2/standard
# Premium alternative (better motion, ~$0.14/s):
# AVATAR_MODEL=fal-ai/bytedance/omnihuman

# Image model for generating avatar personas
IMAGE_MODEL=fal-ai/flux/dev

# Default ElevenLabs voice (Rachel-style conversational female shown; pick from your voice library)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
